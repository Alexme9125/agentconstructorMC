{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentconstructor.mc/schemas/terrain.schema.json",
  "title": "PrintCore terrain IR",
  "type": "object",
  "required": ["kind", "id", "origin", "size", "layers"],
  "properties": {
    "kind": { "const": "terrain" },
    "id": { "type": "string" },
    "dimension": { "type": "string" },
    "origin": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "size": {
      "type": "object",
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 128 },
        "y": { "type": "integer", "minimum": 1 },
        "z": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["offsetY", "block"],
        "properties": {
          "offsetY": { "type": "integer", "minimum": 0 },
          "block": { "type": "string" }
        }
      }
    },
    "heightmap": { "type": ["string", "null"] }
  }
}
